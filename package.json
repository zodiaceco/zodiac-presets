{
  "name": "@zodiaceco/presets",
  "version": "0.1.0",
  "description": "Permission presets for Zodiac constellations",
  "author": "Zodiac Labs GmbH",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/zodiaceco/zodiac-presets",
  "packageManager": "bun@1.3.12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zodiaceco/zodiac-presets.git"
  },
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "abis",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "bun clean",
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "codegen": "bun scripts/codegen.ts",
    "check:format": "prettier --list-different .",
    "check:types": "tsc -p tsconfig.json",
    "fix:format": "prettier --write .",
    "test": "bun test"
  },
  "peerDependencies": {
    "@zodiaceco/sdk": "^2.6.0",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@zodiaceco/sdk": "^2.6.0",
    "ethers": "^6.13.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tsdown": "~0.21.9",
    "typescript": "^5.9.2"
  }
}
